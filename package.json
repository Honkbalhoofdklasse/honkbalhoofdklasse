    "franchise:test:update": "python3 scripts/test-franchise-update.py",
    "franchise:test:growth": "python3 scripts/test-franchise-growth.py",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
