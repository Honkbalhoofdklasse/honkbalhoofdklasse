# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# Next.js and build output
.next/
/out/
/build/
*.tsbuildinfo

# Vercel and Turbo
.vercel
.turbo/

# Environment and secrets (only .env.example is tracked)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json
*-service-account*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing and reports
/coverage/
.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
.lighthouseci/
lhci-reports/
lhr-*.json
lhr-*.html

# Supabase local
supabase/.temp/
supabase/.branches/

# Swift and game runtime (game-runtime/.gitignore also covers these)
.build/
.swiftpm/
.test-native/
game-runtime/.build/
*.xcuserstate
xcuserdata/

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Claude Code local state (project skills in .claude/skills stay tracked)
.claude/settings.local.json
.claude/worktrees/

# Scratch and temp
tmp/
temp/
scratch/
.tmp/
*.tmp
